DISCOVERY_LANGUAGES=["es"]
DISCOVERY_COASTAL_KEYWORDS=["playa","playas","costa","costero","costera","costeros","costeras","litoral","maritimo","maritimo terrestre","maritimo-terrestre","zona maritimo terrestre","zmt","duna","dunas","manglar","manglares","arrecife","arrecifes","humedal","humedales","area protegida","areas protegidas","reserva natural","reserva","bosque","bosque protegido","corredor ecologico","corredor ecológico","estuario","estuarios","karso","carso","cueva","cuevas","terreno protegido","zona protegida"]

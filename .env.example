AUTO_PUBLISH_TRUSTED_PUBLISHERS=["elnuevodia.com","endi.com","primerahora.com","noticel.com","periodismoinvestigativo.com","dialogo.upr.edu","metro.pr","telemundopr.com","wapa.tv","drna.pr.gov","jp.pr.gov","ogpe.pr.gov"]

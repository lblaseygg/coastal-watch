DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/coastal_watch
ADMIN_API_TOKEN=coastal-watch-admin-demo
TAVILY_API_KEY=

# Optional Phase 4 worker tuning
DISCOVERY_QUERIES=["bloqueo de acceso a la playa Puerto Rico","zona maritimo terrestre acceso playa Puerto Rico","permiso de construccion en la costa Puerto Rico","construccion en dunas o manglares Puerto Rico","deslinde de bienes de dominio publico maritimo terrestre Puerto Rico"]
DISCOVERY_DOMAINS=["elnuevodia.com","endi.com","primerahora.com","noticel.com","periodismoinvestigativo.com","dialogo.upr.edu","metro.pr","telemundopr.com","wapa.tv","drna.pr.gov","jp.pr.gov","ogpe.pr.gov"]
DISCOVERY_EXCLUDE_DOMAINS=["facebook.com","instagram.com","x.com","twitter.com","youtube.com","tiktok.com","cleantechnica.com","skift.com","cbsnews.com"]
DISCOVERY_LANGUAGES=["es"]
DISCOVERY_COASTAL_KEYWORDS=["playa","playas","costa","costero","costera","costeros","costeras","litoral","maritimo","maritimo terrestre","maritimo-terrestre","zona maritimo terrestre","zmt","duna","dunas","manglar","manglares","arrecife","arrecifes","humedal","humedales"]
DISCOVERY_ISSUE_KEYWORDS=["acceso","acceso publico","bloqueo","cierre","servidumbre","permiso","permisos","ogpe","drna","construccion","desarrollo","deslinde","dominio publico","erosion","erosion costera","querella","demanda","proyecto","ambiental","proteccion","conservacion","privatizacion"]
SEARCH_TOPIC=news
SEARCH_DEPTH=basic
SEARCH_TIME_RANGE=month
DISCOVERY_INCLUDE_RAW_CONTENT=false

SEARCH_TOPIC=news
SEARCH_DEPTH=basic
SEARCH_TIME_RANGE=month
DISCOVERY_INCLUDE_RAW_CONTENT=false
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_FORMAT=text
